# TRACEBACK LangGraph Investigation Agent Configuration

# LangSmith Tracing & Telemetry
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Tracing Project
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=true

# LLM Providers
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here

# Vector Database (Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=traceback_vectors

# Relational Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traceback_db

# Agent Configuration
DEFAULT_LLM_MODEL=gemini-3.7-flash
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
VISION_LLM_MODEL=gemini-3.7-flash
MAX_TOOL_ITERATIONS=5
MAX_KNOWLEDGE_RETRIEVAL_TOP_K=8
MAX_PREVIOUS_INCIDENTS_TOP_K=2
