# TRACEBACK Backend Environment Configuration Example

APP_NAME=TRACEBACK
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Database Configuration (SQLAlchemy Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traceback_db

# Redis Cache & Worker Configuration (Future)
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage Configuration (Future)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Qdrant Vector Database Configuration (Future)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
