# API Execution Mode: 'mock' (local fixtures) or 'real' (FastAPI server)
NEXT_PUBLIC_API_MODE=mock

# FastAPI Backend Base URL (used when NEXT_PUBLIC_API_MODE=real)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Artificial Latency Simulation in Mock Mode (milliseconds)
NEXT_PUBLIC_MOCK_LATENCY=400
