# ==============================================================================
# TRACEBACK AI — Environment Variables Template
# Copy this file to .env and fill in your confidential API keys & credentials.
# NEVER COMMIT REAL SECRETS OR .env FILES TO GIT OR DOCKER IMAGES.
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traceback_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/traceback_db

# OpenAI API Integration
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith Observability & Tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=TRACEBACK_AI
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Vector Storage (Qdrant Cloud or Local)
QDRANT_URL=https://4f1222f2-61e9-461a-862a-4297725044ff.sa-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Network & Service URLs
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=production
